# Copy to .env and fill in. See app/config.py for all settings.
# Local dev needs none of this — the defaults give you SQLite and an in-process
# OTP store. Everything below matters when you deploy.

ENVIRONMENT=development
DEBUG=true

# Logs every SQL statement AND its bound parameters, which include review text.
# Debugging tool only.
SQL_ECHO=false

DATABASE_URL=postgresql+asyncpg://rentsafe:rentsafe@localhost:5432/rentsafe
REDIS_URL=redis://localhost:6379/0

# How many proxies sit in front of the app (load balancer, CDN, ingress).
# X-Forwarded-For is only trusted this many hops from the right; everything to
# the left was written by the client and can be forged. 0 = no proxy, ignore
# the header entirely. Setting this HIGHER than the real hop count lets callers
# choose their own IP and defeat every per-IP limit, so err low.
TRUSTED_PROXY_HOPS=0

# Object storage for uploaded photos. REQUIRED outside development: without it
# media lives on the container filesystem and every redeploy destroys every
# tenant photo, silently. Any S3-compatible provider works.
#   AWS:            leave MEDIA_ENDPOINT_URL empty
#   Cloudflare R2:  https://<account>.r2.cloudflarestorage.com
#   DO Spaces:      https://<region>.digitaloceanspaces.com
# Credentials come from the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_REGION variables, or an instance role. Keep the bucket PRIVATE — photos
# are moderated and served through the app's own authenticated endpoint.
MEDIA_BUCKET=
MEDIA_ENDPOINT_URL=
MEDIA_PREFIX=media

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:5173

# --- Secrets -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
# The app refuses to start with ENVIRONMENT=production if either value is still
# a placeholder, or if DEBUG is true (debug echoes OTP codes in API responses).
JWT_SECRET=dev-secret-change-me

# Salts the phone-number hashes. Deliberately separate from JWT_SECRET: this is
# the only way back to a user row (plaintext numbers are never stored), so it is
# effectively IMMUTABLE for the life of the database. Changing it orphans every
# account with no recovery path. Falls back to JWT_SECRET when unset.
PHONE_HASH_PEPPER=

# --- OTP throttling ----------------------------------------------------------
OTP_REQUESTS_PER_HOUR=3
OTP_REQUESTS_PER_DAY=10
OTP_RESEND_COOLDOWN_S=60
OTP_MAX_ATTEMPTS=5

# --- Third-party (Section XIV) — optional until those features are wired ------
# Commute comparison. With neither key set the app uses FOSSGIS's public
# Valhalla instance, which needs no key and returns *free-flow* times — the road
# network at its speed limits. That is a different number from what a phone
# shows, and the UI labels it as such ("empty roads, no traffic").
#
# Set either key below to get traffic-aware times instead; the app switches
# automatically and relabels itself. Both are paid.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
WHAT3WORDS_API_KEY=
CLOUDINARY_URL=
TERMII_API_KEY=
SENTRY_DSN=

# --- Backup alerting ---------------------------------------------------------
# Pinged ONLY when a backup succeeds. An external monitor (Healthchecks.io,
# Better Stack, Cronitor — all have free tiers) expects it on a schedule and
# alerts when it stops arriving. This is the only way to catch the job never
# running at all: a failure webhook cannot fire if cron is gone.
BACKUP_HEARTBEAT_URL=
# Posted to on failure. The payload carries both `text` and `content`, so the
# same body works with a Slack or a Discord incoming webhook unchanged.
ALERT_WEBHOOK_URL=
